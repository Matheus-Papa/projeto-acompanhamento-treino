# Banco local (docker compose sobe o Postgres com estes valores)
POSTGRES_DB=treino
POSTGRES_USER=treino
POSTGRES_PASSWORD=treino

# API usa estas variáveis (defaults em application.yml apontam para localhost:5432/treino).
# No compose, SPRING_DATASOURCE_URL é fixo (jdbc:postgresql://db:5432/treino); usuário/senha abaixo vencem o default.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/treino
SPRING_DATASOURCE_USERNAME=treino
SPRING_DATASOURCE_PASSWORD=treino

# JWT OBRIGATÓRIO no .env real (sem default no compose por segurança, mínimo 32 chars).
# Gere com: openssl rand -base64 48
# Nunca commite o .env real nem reuse este exemplo em produção.
JWT_SECRET=troque-por-valor-local-com-mais-de-32-caracteres

# CORS: origem do frontend.
# Dev (npm run dev): http://localhost:5173
# Compose (nginx na porta 80): http://localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend: URL base da API embutida no build (ARG VITE_API_URL).
# Dev: http://localhost:8080 | Compose/web: http://localhost:8080
VITE_API_URL=http://localhost:8080
