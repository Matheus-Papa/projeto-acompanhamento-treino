# Banco local (docker compose sobe o Postgres com estes valores)
POSTGRES_DB=treino
POSTGRES_USER=treino
POSTGRES_PASSWORD=treino

# API usa estas variáveis (defaults em application.yml apontam para localhost:5432/treino)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/treino
SPRING_DATASOURCE_USERNAME=treino
SPRING_DATASOURCE_PASSWORD=treino

# JWT: exemplo local >= 32 chars, nunca usar em produção; gere um valor real no .env
JWT_SECRET=troque-por-valor-local-com-mais-de-32-caracteres

# Frontend dev (Fase 6 restringe o CORS a esta origem via env)
CORS_ALLOWED_ORIGINS=http://localhost:5173
